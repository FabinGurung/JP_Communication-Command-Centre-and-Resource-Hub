{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FabinGurung/jp-ecosystem-project-map-v1/blob/feature/daily-ops-current-work/ops/schema/current-works.schema.json",
  "title": "JP Ecosystem Daily Ops Current Works",
  "type": "object",
  "required": ["schema_version", "authority", "projects"],
  "properties": {
    "schema_version": { "type": "string" },
    "authority": {
      "type": "object",
      "required": ["canonical_state", "event_log", "relational_contract", "projection_rule"],
      "properties": {
        "canonical_state": { "type": "string" },
        "event_log": { "type": "string" },
        "relational_contract": { "type": "string" },
        "projection_rule": { "type": "string" }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_id", "project_slug", "display_name", "contractor", "daily_ops"],
        "properties": {
          "project_id": { "type": "string" },
          "project_slug": { "type": "string" },
          "display_name": { "type": "string" },
          "contractor": { "type": "string" },
          "daily_ops": {
            "type": "object",
            "required": ["date", "overall_readiness", "readiness_summary", "todays_work", "materials", "progress", "blockers", "lookahead", "evidence"],
            "properties": {
              "date": { "type": ["string", "null"] },
              "overall_readiness": {
                "enum": ["READY", "READY_WITH_CONDITION", "HOLD", "NOT_READY", "UNSET"]
              },
              "readiness_summary": {
                "type": "object",
                "required": ["ready", "total"],
                "properties": {
                  "ready": { "type": "integer", "minimum": 0 },
                  "total": { "type": "integer", "minimum": 0 }
                }
              },
              "todays_work": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["work_id", "activity", "location", "execution_status", "readiness"],
                  "properties": {
                    "work_id": { "type": "string" },
                    "activity": { "type": "string" },
                    "location": { "type": "string" },
                    "execution_status": {
                      "enum": ["PLAN", "NOT_STARTED", "ONGOING", "PARTIAL", "DONE", "BLOCKED", "NEEDS_INPUT", "NOTE"]
                    },
                    "readiness": {
                      "type": "object",
                      "required": ["materials", "manpower", "ppe", "work_briefing", "tools", "preconditions", "overall"],
                      "properties": {
                        "materials": { "$ref": "#/$defs/gate" },
                        "manpower": { "$ref": "#/$defs/gate" },
                        "ppe": { "$ref": "#/$defs/gate" },
                        "work_briefing": { "$ref": "#/$defs/gate" },
                        "tools": { "$ref": "#/$defs/gate" },
                        "preconditions": { "$ref": "#/$defs/gate" },
                        "overall": {
                          "enum": ["READY", "READY_WITH_CONDITION", "HOLD", "NOT_READY", "UNSET"]
                        }
                      }
                    },
                    "blocker": { "type": ["string", "null"] },
                    "responsible": { "type": ["string", "null"] },
                    "source_refs": { "type": "array", "items": { "type": "string" } }
                  }
                }
              },
              "materials": { "type": "array", "items": { "type": "object" } },
              "progress": { "type": "array", "items": { "type": "object" } },
              "blockers": { "type": "array", "items": { "type": "object" } },
              "lookahead": { "type": "array", "items": { "type": "object" } },
              "evidence": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["READY", "CONDITION", "HOLD", "NOT_READY", "UNKNOWN", "NOT_APPLICABLE"]
        },
        "note": { "type": ["string", "null"] },
        "responsibility": { "type": ["string", "null"] },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
