  "merge_lane": "feature/daily-ops-current-work",
  "preview_lane": "PULL_REQUEST",
  "publication_lane": "AFTER_MERGE_VALIDATED_GITHUB_PAGES",
  "github_repo_owner_boundary": "ANY_CHAT_MAY_SUBMIT_SCOPED_PR_IF_AUTHORIZED; SHARED_SYSTEM_FILES_REQUIRE_A_SEPARATE_GOVERNED_SYSTEM_LANE",
  "branch_lifecycle": "TEMPORARY_PR_BRANCHES_NOT_PART_OF_LONG_LIVED_ACTIVE_BRANCH_REGISTRY; TRACKED_BY_REGEX; DELETE_AFTER_MERGE_WHEN_TOOL_AVAILABLE",
  "deployment_guarantee": "NO_AUTO_MERGE; PAGES_ONLY_AFTER_USER_OR_AUTHORIZED_AI_MERGES_APPROVED_PR; PRIVATE_SOURCE_NEVER_PUBLIC",
  "known_debt": [
    "GITHUB_BRANCH_PROTECTION_REQUIREMENTS_MUST_BE_SET_WITH_ADMIN_ACCESS",
    "PRIVATE_DRIVE_TO_PUBLIC_SANITIZATION_IS_NOT_AUTOMATED",
