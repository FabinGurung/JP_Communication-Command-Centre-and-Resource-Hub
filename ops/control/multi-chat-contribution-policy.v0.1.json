  ],
  "pages_directory_path": "contributions/index.html",
  "production_index_source": "ONLY_MERGED_APPROVED_PUBLIC_AND_PUBLIC_SAFE_ATTESTED_MANIFESTS",
  "ci_workflow": ".github/workflows/project-contribution-qa.yml",
  "scope_validator": "scripts/validate_project_contributions.py",
